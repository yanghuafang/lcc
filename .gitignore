# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# macOS (Finder metadata; AppleDouble sidecars on non-APFS volumes)
.DS_Store
._*

# Linux (KDE per-folder view; NFS silly-rename temp files)
.directory
.nfs*

# Editor backup / swap files (vim, emacs, gedit, nano, ...)
*~
*.swp
*.swo
*.swn

# clangd / language-server index cache
.cache/

# Coverage profiles. An instrumented lcc writes default.profraw into whatever
# directory it was launched from whenever LLVM_PROFILE_FILE is unset, so one
# lands in scripts/ the first time anyone runs that binary by hand.
# scripts/coverage.sh sets the variable and keeps its own profiles in the build
# directory; these patterns are for the stray ones.
*.profraw
*.profdata
